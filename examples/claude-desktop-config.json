{
  "mcpServers": {
    "cpanel": {
      "command": "node",
      "args": ["/path/to/cpanel-mcp/dist/index.js"],
      "env": {
        "CPANEL_HOSTNAME": "your-cpanel-hostname.com",
        "CPANEL_USERNAME": "your-cpanel-username",
        "CPANEL_API_TOKEN": "your-api-token-here",
        "CPANEL_PORT": "2083",
        "CPANEL_SSL": "true"
      }
    }
  }
}