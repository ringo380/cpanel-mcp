{
  "mcpServers": {
    "cpanel": {
      "command": "node",
      "args": ["/path/to/cpanel-mcp/dist/index.js"],
      "env": {
        "CPANEL_HOSTNAME": "your-server.com",
        "CPANEL_USERNAME": "your_username",
        "CPANEL_API_TOKEN": "your_api_token",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}