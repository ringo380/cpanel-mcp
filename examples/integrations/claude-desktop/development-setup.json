{
  "mcpServers": {
    "cpanel-dev": {
      "command": "node",
      "args": ["/path/to/cpanel-mcp/dist/index.js"],
      "env": {
        "CPANEL_HOSTNAME": "dev-server.example.com",
        "CPANEL_USERNAME": "dev_user",
        "CPANEL_API_TOKEN": "${DEV_CPANEL_API_TOKEN}",
        "CPANEL_SSL": "false",
        "CPANEL_PORT": "2082",
        "CPANEL_TIMEOUT": "60000",
        "CPANEL_MAX_RETRIES": "5",
        "CPANEL_RETRY_DELAY": "500",
        "LOG_LEVEL": "DEBUG",
        "NODE_ENV": "development"
      }
    }
  },
  "development": {
    "verbose": true,
    "debugMode": true,
    "hotReload": true,
    "mockData": false,
    "extendedLogging": {
      "requests": true,
      "responses": true,
      "errors": true,
      "performance": true
    }
  }
}