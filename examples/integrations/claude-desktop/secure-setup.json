{
  "mcpServers": {
    "cpanel-secure": {
      "command": "node",
      "args": ["/path/to/cpanel-mcp/dist/index.js"],
      "env": {
        "CPANEL_HOSTNAME": "secure-server.example.com",
        "CPANEL_USERNAME": "secure_user",
        "CPANEL_API_TOKEN": "${CPANEL_API_TOKEN}",
        "CPANEL_SSL": "true",
        "CPANEL_PORT": "2083",
        "CPANEL_TIMEOUT": "30000",
        "CPANEL_MAX_RETRIES": "3",
        "CPANEL_RETRY_DELAY": "1000",
        "LOG_LEVEL": "WARN",
        "NODE_ENV": "production"
      }
    }
  },
  "security": {
    "rateLimiting": {
      "enabled": true,
      "maxRequests": 60,
      "windowMs": 60000
    },
    "connectionSecurity": {
      "validateCertificates": true,
      "enforceSSL": true,
      "timeoutConnections": 30000
    }
  }
}